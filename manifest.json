{
  "manifest_version": 3,
  "name": "Side Note Editor",
  "version": "0.1.0",
  "description": "Chromeサイドパネル上で動作する、Markdown対応の軽量テキストエディタ",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Side Note Editor を開く"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Side Note Editor を開く"
    }
  }
}
