# ==========================================
# Side Note Editor - Git 除外設定 (.gitignore)
# ==========================================

# --- Chrome拡張機能 開発・ビルド関連 ---
# launch.bat で生成される一時ユーザープロファイル
temp-chrome-profile/
# Chrome拡張パッケージおよび秘密鍵ファイル
*.crx
*.pem

# --- テスト・一時出力ファイル ---
edge-out.html
test-out.html
*.tmp

# --- バックアップ・エクスポートデータ ---
# 動作確認時にダウンロードされたバックアップJSON
side-notes-backup-*.json

# --- ログファイル ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS固有の不要ファイル ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# --- エディタ / IDE 設定 ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- 環境変数・機密情報 ---
.env
.env.local
.env.*.local
